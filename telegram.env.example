# Telegram bot for alerts: the token from @BotFather and your chat ID.
# Copy this file out of the repository, then fill in your values:
#   cp telegram.env.example ~/.config/server-health-check/telegram.env
#   chmod 600 ~/.config/server-health-check/telegram.env
TELEGRAM_BOT_TOKEN=123456:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789
